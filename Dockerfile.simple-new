FROM node:18-alpine

# Add basic build dependencies for SQLite
RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# List files for debugging
RUN ls -la server/ || echo "Server directory not found"

# Build application
RUN npm run build

# Create dist/server directory and copy files safely
RUN mkdir -p ./dist/server/
RUN if [ -f "server/visaconsult.db" ]; then cp server/visaconsult.db ./dist/server/; else echo "Database file not found, will be created"; fi
RUN if [ -f "server/database.sqlite.js" ]; then cp server/database.sqlite.js ./dist/server/; else echo "database.sqlite.js not found"; fi

# Use port 8080 for Fly.io
EXPOSE 8080

CMD ["npm", "start"]
