FROM node:18-alpine

# Add minimal build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy and install dependencies
COPY package*.json ./
RUN npm install

# Copy all source code
COPY . .

# Build the application (this should handle all file copying)
RUN npm run build

# Expose port for Fly.io
EXPOSE 8080

# Start the application
CMD ["npm", "start"]
