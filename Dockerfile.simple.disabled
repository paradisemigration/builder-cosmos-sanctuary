FROM node:18

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Copy database files
RUN mkdir -p ./dist/server/
RUN cp server/visaconsult.db ./dist/server/ || echo "Database will be created"
RUN cp server/database.sqlite.js ./dist/server/

# Expose port
EXPOSE 8080

# Start the application
CMD ["npm", "start"]
